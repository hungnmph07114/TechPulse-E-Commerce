# Root gitignore
node_modules/
dist/
dist-ssr/
.env
.env.*
!.env.example
.vscode/
.idea/
*.log
.DS_Store

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Backend
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/uploads/*
!backend/uploads/.gitkeep

